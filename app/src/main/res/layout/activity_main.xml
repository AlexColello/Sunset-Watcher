<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.acolello.sunsetui.SunsetSceneView
        android:id="@+id/sunset_scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="112dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/offset_text"
            style="@style/SceneText"
            android:textSize="52sp"
            tools:text="45 min" />

        <TextView
            android:id="@+id/offset_caption"
            style="@style/SceneText"
            android:alpha="0.9"
            android:textSize="22sp"
            tools:text="before sunset" />

        <TextView
            android:id="@+id/reminder_text"
            style="@style/SceneText"
            android:layout_marginTop="16dp"
            android:alpha="0.8"
            android:textSize="16sp"
            tools:text="Reminder today at 5:38 PM" />
    </LinearLayout>

    <TextView
        style="@style/SceneText"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="64dp"
        android:alpha="0.6"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:text="@string/slide_hint"
        android:textSize="14sp" />

</FrameLayout>
